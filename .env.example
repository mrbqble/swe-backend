ENV=dev
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/icare
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080
LOG_LEVEL=INFO

# OTP settings
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=3
OTP_BLOCK_MINUTES=15
OTP_RESEND_LIMIT=3
OTP_RESEND_WINDOW_MINUTES=15

# Twilio credentials (required in production for OTP delivery)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=
